+"""One-off (2026-10-29): appends the dated BK entry to status.md, backlog.md and AUTOMATION_TEST_PLAN.md with the REAL test results
+of the server run. Usage:  python3 docs_p5.py <rollback_hash> /tmp/p5_tests.txt
+/tmp/p5_tests.txt = lines "test_name :: <last line of its output> | FAILS=<number of FAIL lines>" written by the test block on the server. The script refuses to
+write anything unless every line shows a passing result, so the docs never claim more than the server really showed.
+Delete this file after use (git rm docs_p5.py)."""
+import re, sys
+from pathlib import Path
+
+MARK = "BK — 2026-10-29"
+rollback = sys.argv[1]
+lines = [l.strip() for l in Path(sys.argv[2]).read_text().splitlines() if l.strip()]
+bad = [l for l in lines if "FAILS=0" not in l or not re.search(r"ALL PASS|\b(\d+)/\1\b|\bPASS\b", l)]
+if not lines or bad:
+    print("REFUSED: the test results are missing or not all passing:")
+    for l in bad or ["(empty file)"]:
+        print("  ", l)
+    sys.exit(2)
+evidence = "\n".join("  - " + l for l in lines)
+
+STATUS = f"""
+
+## {MARK} — "Rifai" allineato alla generazione, filtri foto, watermark solo da scraping, bande GIAL
+- Evidence (causa dell'albero sbavato, cc33f8af scena 0, stesso movimento, Luma ray 3.2 direct): foto dopo la nostra rimozione watermark (variante plain: senza luce e senza upscale) = albero sbavato; foto originale intatta (variante orig) = albero nitido, ma il watermark del portale resta visibile nel clip (Luma non lo toglie). UNA sola coppia di generazioni e Luma non e' deterministico: forte indizio, non prova ripetuta.
+- Evidence: ogni clip Luma esce a 1920x1080, 24 fps, 5.04 s qualunque sia l'input (4800x2700 dopo aura-sr o 1920x1080): l'upscale aura-sr 4x non aggiunge pixel al video; costa tempo e denaro e puo' introdurre difetti. NON ancora provato su un video completo con upscale spento.
+- Evidence: la nitidezza misurata (Laplaciano) su 360 foto di tutti i job NON separa le foto cattive: fogliame e watermark contano come dettaglio (le scene 0 e 5 di cc33f8af risultano tra le piu' "nitide"). Scartata come criterio. Trovati: file da 4x2 px in bd3f0f77, miniature da 486 px in 14 job.
+- Changed (tutto provato solo offline con provider finti): (1) scene_rework: il "Rifai" prepara la foto come la prima generazione: rimozione watermark solo se la scena la chiede, flag del job enhance_images/upscale_images (prima forzati a True/True), file migliorato col nome che dice cosa e' stato fatto (un vecchio file con altre impostazioni non viene riusato), rimozione fallita = foto originale + scena in watermark_failed. (2) build_standard/premium_video_scenes_config: parametro remove_watermark (True per scraping, come prima); il percorso partner/API passa False (prima passava True: foto pulite degli agenti sarebbero state ritoccate). (3) listing_scraper: foto con lato lungo sotto 800 px o non leggibili scartate al download, senza tentativi ripetuti, riportate in download_failures; criteri di qualita' tecnica (sfocata, a blocchi, watermark sul soggetto) aggiunti al ranking Claude vision che c'era gia'; giudizio ok/soft/blocky/watermark sulle foto scelte (intera + ritaglio a pixel reali) in modalita' SOLO MISURA (selection_report.photo_quality); PVS_QUALITY_CHECK=0 lo spegne, PVS_QUALITY_ENFORCE=1 scarta le foto giudicate cattive (mai sotto 5 foto). Un solo mittente vision condiviso. (4) relinx_pilot_check: la copia con bande bianche viene scartata, il ritaglio resta solo come ripiego se restano meno di 5 foto pulite.
+- Decisions (Michele 2026-10-29): il watermark si sceglie da UI nello scraping, mai sul percorso API; per le bande: scartare la copia con bande; upscale: provarlo spento almeno su un caso; luci restano (il cambio colore va migliorato piu' avanti); nessuna spesa senza una strategia chiara.
+- Tests (output reale del server, {rollback} = punto di ritorno):
+{evidence}
+- Not verified: il giudizio di qualita' di Claude vision su foto reali (calibrazione); "Rifai" con fal reale; nessun video con upscale spento; qualita' del video sui job GIAL; il filtro dimensioni su annunci reali.
+- Rollback: commit {rollback} (prima di questo commit).
+"""
+
+BACKLOG = f"""
+
+## {MARK} — voci aperte emerse dalla causa radice dell'albero sbavato
+- Calibrare il giudizio di qualita' Claude vision (measure-only) sulle foto reali: confrontare i verdetti salvati in selection_report.photo_quality con la qualita' dei clip; solo dopo, valutare PVS_QUALITY_ENFORCE=1. Prerequisito per scartare: sostituire una foto scartata con un'altra candidata della stessa categoria (oggi la scena resterebbe corta). Soglia 800 px (lato lungo) e' una scelta mia, da confermare.
+- Upscale aura-sr: provare un job GIAL completo con upscale_images=False e confrontarlo coi video gia' fatti; poi decidere il default. Il flag e' oggi fisso a True alla creazione dei job da URL e partner (api_server): da rendere configurabile per la prova.
+- Rimozione watermark per le foto da scraping: la nostra rimozione sbava le zone coperte (albero di cc33f8af). Da cercare un metodo migliore o accettare il watermark visibile solo in prova; non toccare il percorso API.
+- Correzione luce: sposta i colori (ulivo verso il blu). Da migliorare piu' avanti; per ora resta.
+- Percorso partner: in caso di foto insufficienti il job_dir viene cancellato con shutil.rmtree (api_server, flusso partner), mentre nel percorso da URL la patch L/M non cancella piu' nulla sotto jobs/. Divergenza tra i due percorsi: da allineare (decisione di Michele sul rischio).
+- Pannello QC: numerazione scene 0-based contro elenco 1-based.
+- Rifai: la rimozione watermark nel Rifai non riusa il file della prima generazione (nome per posizione, rischio scena spostata): puo' costare una seconda rimozione. Possibile ottimizzazione solo con un controllo certo che la foto sia la stessa.
+- Filtro foto di Relinx/GIAL: lo scarto delle copie con bande esiste solo nello strumento di prova (relinx_pilot_check); il percorso API reale riceve foto pulite (verificato su cc2aead8), nessuna regola equivalente li' per scelta.
+"""
+
+PLAN = f"""
+
+## {MARK} — aggiunte di stato (i punteggi restano proposte, da rivedere con Michele)
+- Aree di rischio toccate: rework (stato job, costo), qualita' foto, percorso partner. Verifica: test elencati nell'entry BK di status.md (output reale del server). NON verificato con provider reali.
+- F69 (tre percorsi di rework diversi): ulteriore allineamento, il Rifai ora prepara la foto come la prima generazione (test F0-F11 di test_scene_rework). Stato: verificato per funzione, non dal vivo.
+- Righe FMEA PROPOSTE: P10a "Rifai produce un'immagine diversa dalla prima generazione (flag del job ignorati, niente rimozione watermark)" S5 O6 D7 RPN 210 ACT, controllo enhance_flags + test F1-F11; P10b "foto pulite del partner passate dalla rimozione watermark" S6 O9 D5 RPN 270 ACT, controllo remove_watermark=False nel percorso partner (test R2, R4); P10c "foto rotte o miniature accettate (4x2 px, 486 px)" S5 O4 D5 RPN 100 ACT, controllo soglia 800 px (test U1-U6, D3-D6); P10d "foto sfocata, a blocchi o con watermark sul soggetto accettata" S6 O6 D7 RPN 252 ACT, controllo parziale: criteri nel ranking + verdetto in sola misura (non calibrato, scarto spento).
+- Invarianti colpite: stato finale corretto e visibile (il Rifai riproduce la preparazione della prima generazione); costo contato (un Rifai non rifa piu' l'upscale se il job lo aveva spento).
+- Not run: nessuna prova con provider reali; nessuna prova di carico; ripetizioni dell'A/B albero.
+"""
+
+for fname, text in (("status.md", STATUS), ("backlog.md", BACKLOG), ("AUTOMATION_TEST_PLAN.md", PLAN)):
+    p = Path(fname)
+    cur = p.read_text()
+    if MARK in cur:
+        print(fname, ": already has", MARK, "- left alone")
+        continue
+    p.write_text(cur.rstrip("\n") + "\n" + text)
+    print(fname, ": entry added")
