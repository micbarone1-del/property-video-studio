diff --git a/docs_p10.py b/docs_p10.py
new file mode 100644
index 0000000..d495168
--- /dev/null
+++ b/docs_p10.py
@@ -0,0 +1,51 @@
+"""One-off (2026-10-29, evening): appends the dated BP entry to status.md, backlog.md and AUTOMATION_TEST_PLAN.md with the REAL test results
+of the server run. Usage:  python3 docs_p10.py <rollback_hash> /tmp/p10_tests.txt
+/tmp/p10_tests.txt = lines "test_name :: <last line> | FAILS=<n>" written by the test block on the server. The script refuses to
+write anything unless every line shows a passing result, so the docs never claim more than the server really showed.
+Delete this file after use (git rm docs_p10.py)."""
+import re, sys
+from pathlib import Path
+
+MARK = "BP — 2026-10-29"
+rollback = sys.argv[1]
+lines = [l.strip() for l in Path(sys.argv[2]).read_text().splitlines() if l.strip()]
+bad = [l for l in lines if "FAILS=0" not in l or not re.search(r"ALL PASS|\b(\d+)/\1\b|\bPASS\b", l)]
+if not lines or bad:
+    print("REFUSED: the test results are missing or not all passing:")
+    for l in bad or ["(empty file)"]:
+        print("  ", l)
+    sys.exit(2)
+evidence = "\n".join("  - " + l for l in lines)
+
+STATUS = f"""
+
+## {MARK} (sera) — prova di controllo con il prompt in due parole: 14/18; opzione --model per confrontare altri modelli
+- Evidence (corsa reale, stesse 6 foto, 24 chiamate, Haiku 4.5, costo reale 0.0341 EUR): copie peggiorate riconosciute soft/blocky 14 su 18 (blur 6/6, pixelated 3/6, jpegblocks 5/6); originali chiamati soft/blocky 0 su 6; i marchi sovrapposti sono ora etichettati a parte (portal / agency / none). Prima del prompt in due parole: 12 su 18 (pixelated 1/6). Non raggiunge la soglia proposta (16 su 18): il giudice con questo modello resta una rete di sicurezza incompleta (sfocatura sempre riconosciuta, JPEG a blocchi 5/6, pixelazione 3/6). Un campione di 6 foto e 3 tipi di danno sintetico: indicativo, non una misura statistica.
+- Changed: calibrate_quality.py --model NOME giudica UN giro con un altro modello (solo quel processo: chiamate e formula del costo usano quel modello); la produzione non cambia (listing_scraper.MODEL invariato). Il report segnala a gran voce le chiamate fallite (nome modello sbagliato o accesso mancante).
+- Tests (output reale del server):
+{evidence}
+- Not verified: nessun confronto ancora eseguito con altri modelli; scarto soft/blocky ancora in sola misura (.env PVS_QUALITY_ENFORCE=0). I prezzi di claude-haiku-5-5 e claude-sonnet-5-5 sono quelli gia' in CLAUDE_PRICES (listing_scraper), non verificati dal vivo.
+- Rollback: commit {rollback} (prima di questo commit).
+"""
+
+BACKLOG = f"""
+
+## {MARK} (sera) — voci aperte
+- Confrontare altri modelli come giudice con la stessa prova (--model claude-haiku-5-5, poi claude-sonnet-5-5 se serve): scegliere il modello solo se supera la soglia (16/18 e 0 falsi allarmi su 6). Usare un modello diverso in produzione per il solo giudice richiede un costo per modello nel contatore Claude (oggi un solo prezzo, quello di MODEL): da fare PRIMA di cambiare il modello del giudice, altrimenti il costo mostrato sarebbe sbagliato.
+"""
+
+PLAN = f"""
+
+## {MARK} (sera) — aggiunte di stato (punteggi proposti, da rivedere con Michele)
+- P10d (foto sfocata o a blocchi accettata): mitigazione parziale misurata, 14 su 18 copie peggiorate riconosciute (12 prima), 0 falsi allarmi su 6; sotto la soglia proposta di 16 su 18, quindi lo scarto resta spento. Rischio residuo aperto. Punteggi da rivedere.
+- Not run: confronto con altri modelli.
+"""
+
+for fname, text in (("status.md", STATUS), ("backlog.md", BACKLOG), ("AUTOMATION_TEST_PLAN.md", PLAN)):
+    p = Path(fname)
+    cur = p.read_text()
+    if MARK in cur:
+        print(fname, ": already has", MARK, "- left alone")
+        continue
+    p.write_text(cur.rstrip("\n") + "\n" + text)
+    print(fname, ": entry added")
