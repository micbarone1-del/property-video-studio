+"""One-off (2026-10-29, evening): appends the dated BQ entry to status.md, backlog.md and AUTOMATION_TEST_PLAN.md with the REAL test results
+of the server run. Usage:  python3 docs_p11.py <rollback_hash> /tmp/p11_tests.txt
+/tmp/p11_tests.txt = lines "test_name :: <last line> | FAILS=<n>" written by the test block on the server. The script refuses to
+write anything unless every line shows a passing result, so the docs never claim more than the server really showed.
+Delete this file after use (git rm docs_p11.py)."""
+import re, sys
+from pathlib import Path
+
+MARK = "BQ — 2026-10-29"
+rollback = sys.argv[1]
+lines = [l.strip() for l in Path(sys.argv[2]).read_text().splitlines() if l.strip()]
+bad = [l for l in lines if "FAILS=0" not in l or not re.search(r"ALL PASS|\b(\d+)/\1\b|\bPASS\b", l)]
+if not lines or bad:
+    print("REFUSED: the test results are missing or not all passing:")
+    for l in bad or ["(empty file)"]:
+        print("  ", l)
+    sys.exit(2)
+evidence = "\n".join("  - " + l for l in lines)
+
+STATUS = f"""
+
+## {MARK} (sera) — confronto di modelli per il giudice: i modelli piu' forti non rispondono con due parole; risposta con riga ANSWER
+- Evidence (corse reali sulle stesse 6 foto, 24 chiamate a giro): Haiku 5.5 (costo reale 0.0039 EUR): 24 risposte su 24 "unknown"; diagnostica diretta: stop_reason max_tokens a 80 token con SOLO un blocco "thinking" e nessun testo, cioe' il modello pensa prima e il limite di 20 token del giudice lo tagliava. Sonnet 5.5 (costo reale 0.0750 EUR): blur 6/6 e pixelated 6/6 riconosciute, jpegblocks 1/6 con 5 "unknown"; originali: 1 chiamato soft (457d5590, falso allarme da verificare a occhio) e 1 unknown; la diagnostica mostra che scrive una frase di ragionamento invece delle due parole (tagliata a 80 token) e, sulla copia a blocchi, la giudica "acceptable... ok" pur notando il banding: oltre al formato c'e' anche una lettura troppo permissiva del JPEG a blocchi. Haiku 4.5 con prompt in due parole (BP): 14 su 18, 0 falsi allarmi su 6. Nessun modello ha ancora superato la soglia (16 su 18 e 0 falsi allarmi).
+- Changed: il giudice puo' ragionare (al massimo due frasi) e chiude con una riga "ANSWER: <tecnico> <sovrapposizione>"; le parole si leggono DOPO l'ultimo "answer:" (_vision_word_from_b64 ha ora max_tokens e marker; il valore predefinito e le domande sulle stanze restano identici: parola unica, 20 token). Senza riga ANSWER, o con la risposta tagliata, il verdetto e' unknown (mai un problema). max_tokens del giudice 600 (QUALITY_JUDGE_MAX_TOKENS). Il giudice produce ora circa 70-100 token in uscita a foto (prima circa 5): costo in uscita trascurabile ma reale, da verificare con la corsa; calibrate_quality.py stima ora 90 token in uscita.
+- Tests (output reale del server):
+{evidence}
+- Not verified: NESSUNA corsa reale con la riga ANSWER (i test usano un client finto): non so se cambia i risultati ne' se Haiku 4.5, Haiku 5.5 e Sonnet 5.5 ora superano la soglia. Scarto soft/blocky ancora in sola misura (.env PVS_QUALITY_ENFORCE=0). Produzione: il giudice di produzione usa il prompt nuovo (chiamate piu' lunghe di qualche secondo possibile) ma i suoi verdetti non scartano nulla.
+- Rollback: commit {rollback} (prima di questo commit).
+"""
+
+BACKLOG = f"""
+
+## {MARK} (sera) — voci aperte
+- Rilanciare la prova con la riga ANSWER su tre modelli: claude-haiku-4-5-20251001 (produzione), claude-haiku-5-5, claude-sonnet-5-5 (costo totale stimato circa 0.13 EUR). Se solo un modello non-default supera la soglia: prima il conteggio del costo per modello, poi il cambio.
+- Lettura troppo permissiva del JPEG a blocchi da parte di Sonnet: se resta dopo la riga ANSWER, rafforzare la definizione di "blocky" (banding o blocchi visibili al ritaglio a 100% anche se lievi) e ripetere la prova, controllando i falsi allarmi sugli originali.
+"""
+
+PLAN = f"""
+
+## {MARK} (sera) — aggiunte di stato (punteggi proposti, da rivedere con Michele)
+- P10d: un confronto reale tra modelli ha mostrato un secondo difetto di processo (formato di risposta non adatto a modelli che ragionano); correzione con riga ANSWER testata solo con client finto (Q1b-Q1f). Rischio residuo aperto; scarto spento.
+- Not run: corsa reale con la riga ANSWER.
+"""
+
+for fname, text in (("status.md", STATUS), ("backlog.md", BACKLOG), ("AUTOMATION_TEST_PLAN.md", PLAN)):
+    p = Path(fname)
+    cur = p.read_text()
+    if MARK in cur:
+        print(fname, ": already has", MARK, "- left alone")
+        continue
+    p.write_text(cur.rstrip("\n") + "\n" + text)
+    print(fname, ": entry added")
