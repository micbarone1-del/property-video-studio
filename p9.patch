new file mode 100644
index 0000000..753fca2
--- /dev/null
+++ b/docs_p9.py
@@ -0,0 +1,51 @@
+"""One-off (2026-10-29, evening): appends the dated BO entry to status.md, backlog.md and AUTOMATION_TEST_PLAN.md with the REAL test results
+of the server run. Usage:  python3 docs_p9.py <rollback_hash> /tmp/p9_tests.txt
+/tmp/p9_tests.txt = lines "test_name :: <last line> | FAILS=<n>" written by the test block on the server. The script refuses to
+write anything unless every line shows a passing result, so the docs never claim more than the server really showed.
+Delete this file after use (git rm docs_p9.py)."""
+import re, sys
+from pathlib import Path
+
+MARK = "BO — 2026-10-29"
+rollback = sys.argv[1]
+lines = [l.strip() for l in Path(sys.argv[2]).read_text().splitlines() if l.strip()]
+bad = [l for l in lines if "FAILS=0" not in l or not re.search(r"ALL PASS|\b(\d+)/\1\b|\bPASS\b", l)]
+if not lines or bad:
+    print("REFUSED: the test results are missing or not all passing:")
+    for l in bad or ["(empty file)"]:
+        print("  ", l)
+    sys.exit(2)
+evidence = "\n".join("  - " + l for l in lines)
+
+STATUS = f"""
+
+## {MARK} (sera) — prova di controllo con foto peggiorate: il giudice trascurava il difetto tecnico; risposta in due parole
+- Evidence (corsa reale, 6 foto x [originale + blur + pixelated + jpegblocks] = 24 chiamate, Haiku 4.5, costo reale 0.0333 EUR, prompt di BN): copie peggiorate riconosciute soft/blocky 12 su 18 (blur 6/6, jpegblocks 5/6, pixelated 1/6); originali chiamati soft/blocky 0 su 6 (tutti "portal"). Michele ha guardato i fogli: le copie pixelate (risposta "portal") sono evidentemente sfocate/impoverite e la copia jpegblocks con logo kw HOME (risposta "portal") e' evidentemente posterizzata: il giudice NOMINAVA il marchio e saltava il giudizio tecnico, nonostante la frase "controlla prima i difetti tecnici". Il filtro cosi' com'era non va bene (Michele: "il filtro va migliorato").
+- Changed: il giudice risponde con DUE parole: prima il giudizio tecnico (ok / soft / blocky), poi cio' che e' sovrapposto (none / portal / agency), con la frase esplicita che la prima parola non dipende dalla seconda. "soft" copre anche una foto a bassa risoluzione ingrandita; "blocky" anche chiazze di colore piatte (posterizzazione). Verdetto tecnico = p["quality"] (unico che scarta, solo soft e blocky); overlay = p["overlay"] (solo etichetta, anche nel selection_report). La parola unica "portal" non e' piu' un verdetto tecnico (diventa unknown, mai un problema). Un solo mittente: _vision_word_from_b64 ha ora words=2. calibrate_quality.py stampa e salva anche l'overlay.
+- Tests (output reale del server):
+{evidence}
+- Not verified: la stessa prova di controllo con il nuovo prompt NON e' ancora stata rilanciata (stesse 6 foto, 24 chiamate, circa 0.033 EUR): nessun dato reale sul nuovo prompt. Scarto soft/blocky ancora in sola misura (.env PVS_QUALITY_ENFORCE=0).
+- Rollback: commit {rollback} (prima di questo commit).
+"""
+
+BACKLOG = f"""
+
+## {MARK} (sera) — voci aperte
+- Rilanciare la prova di controllo con il nuovo prompt (stesse foto, circa 0.033 EUR). Soglia per riattivare lo scarto (proposta, da confermare con Michele): copie peggiorate riconosciute in blocco >= 16 su 18 e 0 falsi allarmi sui 6 originali. Se la pixelazione resta invisibile al giudice: provare un modello piu' forte solo per questo giudizio (costo da stimare).
+"""
+
+PLAN = f"""
+
+## {MARK} (sera) — aggiunte di stato (punteggi proposti, da rivedere con Michele)
+- P10d (foto sfocata o a blocchi accettata): CONFERMATA dalla prova di controllo (12/18 riconosciute, il giudice nominava il marchio al posto del difetto). Mitigazione in prova: risposta in due parole separate. Stato: test con giudice finto (Q1b, Q1c, Q6, Q8b); nessun dato reale sul nuovo prompt. Punteggi da rivedere: O osservata alta.
+- Not run: prova di controllo con il nuovo prompt.
+"""
+
+for fname, text in (("status.md", STATUS), ("backlog.md", BACKLOG), ("AUTOMATION_TEST_PLAN.md", PLAN)):
+    p = Path(fname)
+    cur = p.read_text()
+    if MARK in cur:
+        print(fname, ": already has", MARK, "- left alone")
+        continue
+    p.write_text(cur.rstrip("\n") + "\n" + text)
+    print(fname, ": entry added")
