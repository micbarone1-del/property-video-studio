@@ -0,0 +1,55 @@
+"""One-off (2026-10-29, evening): appends the dated BN entry to status.md, backlog.md and AUTOMATION_TEST_PLAN.md with the REAL test results
+of the server run. Usage:  python3 docs_p8.py <rollback_hash> /tmp/p8_tests.txt
+/tmp/p8_tests.txt = lines "test_name :: <last line> | FAILS=<n>" written by the test block on the server. The script refuses to
+write anything unless every line shows a passing result, so the docs never claim more than the server really showed.
+Delete this file after use (git rm docs_p8.py)."""
+import re, sys
+from pathlib import Path
+
+MARK = "BN — 2026-10-29"
+rollback = sys.argv[1]
+lines = [l.strip() for l in Path(sys.argv[2]).read_text().splitlines() if l.strip()]
+bad = [l for l in lines if "FAILS=0" not in l or not re.search(r"ALL PASS|\b(\d+)/\1\b|\bPASS\b", l)]
+if not lines or bad:
+    print("REFUSED: the test results are missing or not all passing:")
+    for l in bad or ["(empty file)"]:
+        print("  ", l)
+    sys.exit(2)
+evidence = "\n".join("  - " + l for l in lines)
+
+STATUS = f"""
+
+## {MARK} (sera) — calibrazione del giudice qualita' sulle foto passate: "watermark" non e' piu' motivo di scarto; verdetti portal/agency; prova di controllo con foto peggiorate
+- Evidence (corsa reale, 2026-10-29, blocco 227+): 101 foto uniche originali dei job passati (361 file letti, 255 duplicati, 5 troppo piccole), giudice Claude Haiku 4.5 con il prompt di BL. Esito: watermark=78, ok=23, soft=0, blocky=0; costo reale 0.1348 EUR (101 chiamate, 142513 token in, 482 out). Fogli di miniature guardati da Michele e da me: le 78 foto "watermark" hanno tutte davvero il marchio del portale (immobiliare.it) o il logo kw HOME; tra le 23 "ok" ci sono foto col fiocco blu dell'agenzia Honard (giudicate ok) e alcune con il marchio immobiliare.it piu' sbiadito (giudicate ok): il giudice segnalava la presenza del marchio, in modo incoerente. In nessun foglio ho visto una foto sfocata o a blocchi, e il giudice non ne ha trovate: la parte soft/blocky NON e' mai stata messa alla prova da foto cattive.
+- Consequence: con lo scarto attivo (default di BL) uno scraping da portale avrebbe perso circa 3 foto su 4. Michele: PVS_QUALITY_ENFORCE=0 impostato nel .env del server e server riavviato (blocco 228, verificato: riga presente, health ok). Questo stato e' SOLO nel .env, non nel codice.
+- Changed (questo commit): (1) PHOTO_QUALITY_PROMPT: parole ok / soft / blocky / portal / agency; prima i difetti tecnici (soft, blocky), poi, solo se non ci sono, portal = marchio semitrasparente di un portale, agency = logo/fiocco/barra dell'agenzia. (2) PHOTO_QUALITY_POOR = (soft, blocky): portal e agency sono solo etichette nel verdetto (p["quality"], selection_report), mai scarto. Provvisorio per decisione di Michele: da rivedere dopo la prova di controllo e il lavoro reale GIAL. (3) La frase del gap di qualita' dice "blurred or pixelated". (4) calibrate_quality.py --degrade-test N: prova di controllo, N foto x (originale + 3 copie peggiorate apposta: blur, pixelated, jpegblocks) scritte in --out/degraded (mai in jobs/); riporta quante copie peggiorate sono riconosciute soft/blocky e quanti originali sono falsi allarmi; senza --run e' una simulazione. Il prompt del RANKING (QUALITY_RANKING_PROMPT) penalizza ancora un watermark grande sul soggetto: non toccato.
+- Tests (output reale del server):
+{evidence}
+- Not verified: la prova di controllo non e' stata ancora lanciata (nessun dato su soft/blocky); i nuovi verdetti portal/agency non sono mai stati visti da Claude reale; scarto per soft/blocky NON riattivato.
+- Rollback: commit {rollback} (prima di questo commit).
+"""
+
+BACKLOG = f"""
+
+## {MARK} (sera) — voci aperte
+- Lanciare la prova di controllo (--degrade-test 6 --run, circa 0.03 EUR, 24 chiamate) e leggere i risultati con Michele; solo se le copie peggiorate sono riconosciute e gli originali non danno falsi allarmi, riattivare PVS_QUALITY_ENFORCE (rimuovere la riga =0 dal .env) per soft/blocky.
+- Rivedere con Michele il ruolo di portal/agency dopo il lavoro reale GIAL (provvisorio). Il prompt del RANKING penalizza ancora il watermark sul soggetto: coerenza da decidere.
+- Il test sulle foto di job passati non contiene foto cattive vere: raccogliere esempi reali di foto sfocate/a blocchi (da annunci futuri) per una calibrazione piu' onesta.
+"""
+
+PLAN = f"""
+
+## {MARK} (sera) — aggiunte di stato (punteggi proposti, da rivedere con Michele)
+- P10e (falso positivo del giudice) CONFERMATO dalla calibrazione: 78 di 101 foto giudicate "watermark", cioe' il rischio era reale. Mitigazione: watermark tolto dai motivi di scarto e scarto in sola misura (PVS_QUALITY_ENFORCE=0). Rischio residuo: soft/blocky non verificato (prova di controllo non ancora eseguita). Punteggi da rivedere: O sale (osservato), D scende (rilevato dalla calibrazione).
+- P10d (foto sfocata o a blocchi accettata) resta aperta: nessun test con foto cattive vere finora.
+- Not run: prova di controllo con foto peggiorate; nessuna prova con provider reali sul giudice con le nuove parole.
+"""
+
+for fname, text in (("status.md", STATUS), ("backlog.md", BACKLOG), ("AUTOMATION_TEST_PLAN.md", PLAN)):
+    p = Path(fname)
+    cur = p.read_text()
+    if MARK in cur:
+        print(fname, ": already has", MARK, "- left alone")
+        continue
+    p.write_text(cur.rstrip("\n") + "\n" + text)
+    print(fname, ": entry added")
